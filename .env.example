# ============================================================
# FixHomi Auth Service - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# For local development with H2, you don't need most of these
# ============================================================

# ------------------------------------------------------------
# DATABASE (Required for production with Neon/Supabase)
# ------------------------------------------------------------
# Get these from your Neon dashboard: https://console.neon.tech
# Format the JDBC URL parts separately (JDBC doesn't support credentials in URL)

DATABASE_HOST=your_database_host
DATABASE_NAME=your_database_name
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password
# ------------------------------------------------------------
# JWT CONFIGURATION (Required for production)
# ------------------------------------------------------------
# Generate a secure secret: openssl rand -base64 64
# Must be at least 512 bits (64+ characters) for HS512

JWT_SECRET=your_jwt_secret_here

# ------------------------------------------------------------
# GOOGLE OAUTH2 (Required for Google Sign-In)
# ------------------------------------------------------------
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# IMPORTANT: For mobile Google Sign-In (React Native/iOS/Android),
# you need to create OAuth client IDs for each platform in the SAME project.
# Web client ID is used for redirect-based OAuth flow.
# iOS/Android client IDs are used for mobile SDK token verification.

# Web OAuth client ID (MUST match frontend webClientId for ID token audience verification)
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Mobile OAuth client IDs (from the SAME Google Cloud project as frontend)
# Android client ID from google-services.json (type 1)
# iOS uses the Web client ID since no separate iOS client exists yet
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id

# ------------------------------------------------------------
# EMAIL SERVICE - Brevo (Production ready)
# ------------------------------------------------------------
# Get API key from: https://app.brevo.com/settings/keys/api

EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_sender_email
BREVO_SENDER_NAME=FixHomi

# ------------------------------------------------------------
# SMS SERVICE - Twilio (Optional, uses stub in development)
# ------------------------------------------------------------
# Get credentials from: https://console.twilio.com

# Use FIXHOMI_NOTIFICATION_SMS_PROVIDER for Spring Boot property binding
# Options: 'stub' (dev), 'twilio', 'msg91' (production)
FIXHOMI_NOTIFICATION_SMS_PROVIDER=msg91
SMS_PROVIDER=msg91
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ------------------------------------------------------------
# SMS SERVICE - MSG91 (Alternative to Twilio)
# ------------------------------------------------------------
# Get credentials from: https://control.msg91.com
# To use MSG91 instead of Twilio, set SMS_PROVIDER=msg91

MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_DELETE_TEMPLATE_ID=your_msg91_delete_template_id
MSG91_VERIFICATION_TEMPLATE_ID=your_msg91_verification_template_id
MSG91_SENDER_ID=FXHOMI

# ------------------------------------------------------------
# APPLICATION URLS
# ------------------------------------------------------------
# Base URL of your deployed auth service
FIXHOMI_BASE_URL=https://your-auth-service.onrender.com

# Frontend app URL (for password reset links)
FIXHOMI_FRONTEND_URL=http://localhost:3000

# Node.js Backend API URL (for inter-service communication)
NODEJS_BACKEND_URL=http://localhost:5001

# ------------------------------------------------------------
# CORS CONFIGURATION (Security)
# ------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# Add all your frontend and backend URLs that need to access this service
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001,http://localhost:8081,http://localhost:19006

# ------------------------------------------------------------
# RATE LIMITING (Optional - enabled by default)
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------
PORT=8080

# Spring profile: 'default' for H2, 'prod' for PostgreSQL
SPRING_PROFILES_ACTIVE=prod
