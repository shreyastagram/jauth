# ============================================================
# FixHomi Auth Service — LOCAL DEVELOPMENT environment
# ============================================================
# Use this file (not .env.example) on your laptop:
#
#   cp .env.local.example .env
#   # replace JWT_SECRET with the output of:  openssl rand -base64 64 | tr -d '\n'
#   ./run.sh local
#
# Everything else for local development (H2 database, stub SMS/email,
# seeded admin account) lives in src/main/resources/application-local.yaml.
#
# Full walkthrough: docs/onboarding/01-local-setup.md
# ============================================================

# REQUIRED — HS512 signing key for access tokens. application.yaml has no
# default for it, so the service will not start without this value.
JWT_SECRET=replace_me_with_output_of_openssl_rand_base64_64

# Selects src/main/resources/application-local.yaml
SPRING_PROFILES_ACTIVE=local

# OPTIONAL — credentials of the ADMIN account created on first start.
# LOCAL_ADMIN_EMAIL=admin@fixhomi.local
# LOCAL_ADMIN_PASSWORD=LocalAdmin@123

# OPTIONAL — set to false if repeated Postman runs hit 429 Too Many Requests.
# RATE_LIMIT_ENABLED=true
