          "name": "7 \u00b7 Support unblocks the customer \u2192 200",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{BASE_URL}}/api/support/users/{{SP_CUSTOMER_ID}}/status",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{SP_SUPPORT_TOKEN}}",
                  "type": "string"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const b = pm.response.json();",
                  "pm.test('account is active again', function () { pm.expect(b.isActive).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8 \u00b7 Support touches an ADMIN account \u2192 404",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{BASE_URL}}/api/support/users/{{SP_ADMIN_ID}}/status",
            "description": "Security check: support cannot disable admins, and cannot even tell that an admin exists.",
            "body": {
              "mode": "raw",
